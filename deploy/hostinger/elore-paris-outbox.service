[Unit]
Description=Elore Paris authority outbox retry worker
After=elore-paris.service
Requires=elore-paris.service

[Service]
Type=oneshot
User=elore
Group=elore
WorkingDirectory=/srv/elore-paris/current
EnvironmentFile=/etc/elore-paris/elore-paris.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /srv/elore-paris/current/scripts/run-outbox-worker.mjs
TimeoutStartSec=65s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/elore-paris
UMask=0027
